#if defined XOPEN2K24 || defined POSIX2024
type locale_t

function {char*} bind_textdomain_codeset (const char*, const char*)
function {char*} bindtextdomain (const char*, const char*)
function {char*} dcgettext (const char*, const char*, int)
function {char*} dcgettext_l (const char*, const char*, int, locale_t)
function {char*} dcngettext (const char*, const char*, const char*, unsigned long int, int)
function {char*} dcngettext_l (const char*, const char*, const char*, unsigned long int, int, locale_t)
function {char*} dgettext (const char*, const char*)
function {char*} dgettext_l (const char*, const char*, locale_t)
function {char*} dngettext (const char*, const char*, const char*, unsigned long int)
function {char*} dngettext_l (const char*, const char*, const char*, unsigned long int, locale_t)
function {char*} gettext (const char*)
function {char*} gettext_l (const char*, locale_t)
function {char*} ngettext (const char*, const char*, unsigned long int)
function {char*} ngettext_l (const char*, const char*, unsigned long int, locale_t)
function {char*} textdomain (const char*)

allow *_t
#endif
