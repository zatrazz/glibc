#if !defined ISO && !defined ISO99 && !defined ISO11 && !defined ISO23 && !defined POSIX && !defined XPG4
type {struct pollfd}
element {struct pollfd} int fd
element {struct pollfd} {short int} events
element {struct pollfd} {short int} revents

type nfds_t

constant POLLIN
constant POLLRDNORM
constant POLLRDBAND
constant POLLPRI
constant POLLOUT
constant POLLWRNORM
constant POLLWRBAND
constant POLLERR
constant POLLHUP
constant POLLNVAL

function int poll (struct pollfd[], nfds_t, int)
#if defined XOPEN2K24 || defined POSIX2024
type sigset_t
type {struct timespec}
function int ppoll (struct pollfd[], nfds_t, const struct timespec*, const sigset_t*)

allow tv_*
#endif

allow pd_*
allow ph_*
allow ps_*
allow POLL*
allow *_t
#endif
